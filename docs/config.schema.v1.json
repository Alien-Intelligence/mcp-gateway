{
  "$defs": {
    "AuditConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "AuditConfig",
      "type": "object"
    },
    "AuthConfig": {
      "additionalProperties": false,
      "properties": {
        "algorithms": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Algorithms",
          "type": "array"
        },
        "audiences": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Audiences",
          "type": "array"
        },
        "clock_skew_seconds": {
          "minimum": 0,
          "title": "Clock Skew Seconds",
          "type": "number"
        },
        "identity": {
          "$ref": "#/$defs/IdentityPathsConfig"
        },
        "issuer": {
          "title": "Issuer",
          "type": "string"
        },
        "jwks_cache_ttl_seconds": {
          "exclusiveMinimum": 0,
          "title": "Jwks Cache Ttl Seconds",
          "type": "number"
        },
        "jwks_fetch_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Jwks Fetch Timeout Seconds",
          "type": "number"
        },
        "jwks_max_stale_seconds": {
          "minimum": 0,
          "title": "Jwks Max Stale Seconds",
          "type": "number"
        },
        "jwks_uri": {
          "title": "Jwks Uri",
          "type": "string"
        },
        "required_scopes": {
          "items": {
            "type": "string"
          },
          "title": "Required Scopes",
          "type": "array"
        },
        "scopes_advertised": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Scopes Advertised",
          "type": "array"
        }
      },
      "required": [
        "issuer",
        "jwks_uri",
        "audiences",
        "algorithms",
        "required_scopes",
        "scopes_advertised",
        "clock_skew_seconds",
        "jwks_cache_ttl_seconds",
        "jwks_max_stale_seconds",
        "jwks_fetch_timeout_seconds",
        "identity"
      ],
      "title": "AuthConfig",
      "type": "object"
    },
    "ChainResolverConfig": {
      "additionalProperties": false,
      "properties": {
        "resolvers": {
          "items": {
            "discriminator": {
              "mapping": {
                "static": "#/$defs/StaticResolverConfig",
                "store_redis": "#/$defs/StoreRedisResolverConfig",
                "store_sql": "#/$defs/StoreSqlResolverConfig",
                "webhook": "#/$defs/WebhookResolverConfig"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/StaticResolverConfig"
              },
              {
                "$ref": "#/$defs/WebhookResolverConfig"
              },
              {
                "$ref": "#/$defs/StoreSqlResolverConfig"
              },
              {
                "$ref": "#/$defs/StoreRedisResolverConfig"
              }
            ]
          },
          "minItems": 2,
          "title": "Resolvers",
          "type": "array"
        },
        "type": {
          "const": "chain",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "resolvers"
      ],
      "title": "ChainResolverConfig",
      "type": "object"
    },
    "HmacAuthConfig": {
      "additionalProperties": false,
      "properties": {
        "secret_file": {
          "minLength": 1,
          "title": "Secret File",
          "type": "string"
        },
        "type": {
          "const": "hmac",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "secret_file"
      ],
      "title": "HmacAuthConfig",
      "type": "object"
    },
    "IdentityPathsConfig": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Email"
        },
        "email_verified": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Email Verified"
        },
        "groups": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Groups"
        },
        "organization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Organization"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "email",
        "email_verified",
        "organization",
        "groups"
      ],
      "title": "IdentityPathsConfig",
      "type": "object"
    },
    "LabelMatchConfig": {
      "additionalProperties": false,
      "description": "Matches one of the labels the credential resolver returned.",
      "properties": {
        "label": {
          "$ref": "#/$defs/LabelSelectorConfig"
        }
      },
      "required": [
        "label"
      ],
      "title": "LabelMatchConfig",
      "type": "object"
    },
    "LabelSelectorConfig": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "LabelSelectorConfig",
      "type": "object"
    },
    "LimitsConfig": {
      "additionalProperties": false,
      "properties": {
        "max_filtered_response_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Filtered Response Bytes",
          "type": "integer"
        },
        "max_request_body_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Request Body Bytes",
          "type": "integer"
        },
        "max_sse_event_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Sse Event Bytes",
          "type": "integer"
        },
        "request_body_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Request Body Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "max_request_body_bytes",
        "request_body_timeout_seconds",
        "max_sse_event_bytes",
        "max_filtered_response_bytes"
      ],
      "title": "LimitsConfig",
      "type": "object"
    },
    "ListenConfig": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        }
      },
      "required": [
        "host",
        "port"
      ],
      "title": "ListenConfig",
      "type": "object"
    },
    "MemoryStateConfig": {
      "additionalProperties": false,
      "description": "Per-process state: correct for exactly one replica.",
      "properties": {
        "type": {
          "const": "memory",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "MemoryStateConfig",
      "type": "object"
    },
    "MtlsAuthConfig": {
      "additionalProperties": false,
      "properties": {
        "client_cert_file": {
          "minLength": 1,
          "title": "Client Cert File",
          "type": "string"
        },
        "client_key_file": {
          "minLength": 1,
          "title": "Client Key File",
          "type": "string"
        },
        "type": {
          "const": "mtls",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "client_cert_file",
        "client_key_file"
      ],
      "title": "MtlsAuthConfig",
      "type": "object"
    },
    "ObservabilityConfig": {
      "additionalProperties": false,
      "properties": {
        "otlp": {
          "anyOf": [
            {
              "$ref": "#/$defs/OtlpConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "otlp"
      ],
      "title": "ObservabilityConfig",
      "type": "object"
    },
    "OrganizationMatchConfig": {
      "additionalProperties": false,
      "description": "Matches ``Identity.organization`` (the token's organization claim).",
      "properties": {
        "organization": {
          "minLength": 1,
          "title": "Organization",
          "type": "string"
        }
      },
      "required": [
        "organization"
      ],
      "title": "OrganizationMatchConfig",
      "type": "object"
    },
    "OtlpConfig": {
      "additionalProperties": false,
      "description": "OTLP export of traces and metrics. Only the endpoint's address is configured here.",
      "properties": {
        "allow_insecure_http": {
          "title": "Allow Insecure Http",
          "type": "boolean"
        },
        "endpoint": {
          "title": "Endpoint",
          "type": "string"
        },
        "export_interval_seconds": {
          "exclusiveMinimum": 0,
          "title": "Export Interval Seconds",
          "type": "number"
        },
        "headers_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Headers File"
        },
        "protocol": {
          "enum": [
            "grpc",
            "http/protobuf"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "resource_attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Resource Attributes",
          "type": "object"
        },
        "service_name": {
          "minLength": 1,
          "title": "Service Name",
          "type": "string"
        },
        "timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "endpoint",
        "protocol",
        "headers_file",
        "allow_insecure_http",
        "timeout_seconds",
        "export_interval_seconds",
        "service_name",
        "resource_attributes"
      ],
      "title": "OtlpConfig",
      "type": "object"
    },
    "PoliciesConfig": {
      "additionalProperties": false,
      "properties": {
        "allowed_origins": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Origins",
          "type": "array"
        },
        "rate_limits": {
          "anyOf": [
            {
              "$ref": "#/$defs/RateLimitsConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "tools": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolsPolicyConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "rate_limits",
        "allowed_origins",
        "tools"
      ],
      "title": "PoliciesConfig",
      "type": "object"
    },
    "RateLimitsConfig": {
      "additionalProperties": false,
      "description": "Token buckets per subject and, optionally, per organization.\n\n``per_subject`` is required: a subject whose token carries no organization is charged to no\norganization bucket, so without a subject bucket it would be unlimited.",
      "properties": {
        "per_organization": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenBucketConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "per_subject": {
          "$ref": "#/$defs/TokenBucketConfig"
        }
      },
      "required": [
        "per_subject",
        "per_organization"
      ],
      "title": "RateLimitsConfig",
      "type": "object"
    },
    "RedisStateConfig": {
      "additionalProperties": false,
      "description": "State shared by every replica in one Redis; any failure of it fails requests closed.",
      "properties": {
        "connect_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Connect Timeout Seconds",
          "type": "number"
        },
        "encryption_key_file": {
          "minLength": 1,
          "title": "Encryption Key File",
          "type": "string"
        },
        "key_prefix": {
          "title": "Key Prefix",
          "type": "string"
        },
        "max_connections": {
          "minimum": 1,
          "title": "Max Connections",
          "type": "integer"
        },
        "operation_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Operation Timeout Seconds",
          "type": "number"
        },
        "type": {
          "const": "redis",
          "title": "Type",
          "type": "string"
        },
        "url_file": {
          "minLength": 1,
          "title": "Url File",
          "type": "string"
        }
      },
      "required": [
        "type",
        "url_file",
        "key_prefix",
        "connect_timeout_seconds",
        "operation_timeout_seconds",
        "max_connections",
        "encryption_key_file"
      ],
      "title": "RedisStateConfig",
      "type": "object"
    },
    "ResolverCacheConfig": {
      "additionalProperties": false,
      "properties": {
        "max_entries": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Entries"
        },
        "negative_ttl_seconds": {
          "exclusiveMinimum": 0,
          "title": "Negative Ttl Seconds",
          "type": "number"
        },
        "positive_ttl_seconds": {
          "exclusiveMinimum": 0,
          "title": "Positive Ttl Seconds",
          "type": "number"
        }
      },
      "required": [
        "positive_ttl_seconds",
        "negative_ttl_seconds",
        "max_entries"
      ],
      "title": "ResolverCacheConfig",
      "type": "object"
    },
    "SessionsConfig": {
      "additionalProperties": false,
      "description": "Binding of an upstream ``Mcp-Session-Id`` to the subject that created it.",
      "properties": {
        "idle_ttl_seconds": {
          "exclusiveMinimum": 0,
          "title": "Idle Ttl Seconds",
          "type": "number"
        },
        "max_entries": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Entries"
        },
        "max_entries_per_subject": {
          "exclusiveMinimum": 0,
          "title": "Max Entries Per Subject",
          "type": "integer"
        }
      },
      "required": [
        "max_entries",
        "max_entries_per_subject",
        "idle_ttl_seconds"
      ],
      "title": "SessionsConfig",
      "type": "object"
    },
    "StaticResolverConfig": {
      "additionalProperties": false,
      "properties": {
        "mapping_file": {
          "minLength": 1,
          "title": "Mapping File",
          "type": "string"
        },
        "type": {
          "const": "static",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "mapping_file"
      ],
      "title": "StaticResolverConfig",
      "type": "object"
    },
    "StoreRedisResolverConfig": {
      "additionalProperties": false,
      "properties": {
        "connect_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Connect Timeout Seconds",
          "type": "number"
        },
        "default_upstream": {
          "minLength": 1,
          "title": "Default Upstream",
          "type": "string"
        },
        "key_pattern": {
          "title": "Key Pattern",
          "type": "string"
        },
        "max_connections": {
          "minimum": 1,
          "title": "Max Connections",
          "type": "integer"
        },
        "socket_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Socket Timeout Seconds",
          "type": "number"
        },
        "type": {
          "const": "store_redis",
          "title": "Type",
          "type": "string"
        },
        "url_file": {
          "minLength": 1,
          "title": "Url File",
          "type": "string"
        }
      },
      "required": [
        "type",
        "url_file",
        "key_pattern",
        "default_upstream",
        "connect_timeout_seconds",
        "socket_timeout_seconds",
        "max_connections"
      ],
      "title": "StoreRedisResolverConfig",
      "type": "object"
    },
    "StoreSqlResolverConfig": {
      "additionalProperties": false,
      "properties": {
        "connect_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Connect Timeout Seconds",
          "type": "number"
        },
        "default_upstream": {
          "minLength": 1,
          "title": "Default Upstream",
          "type": "string"
        },
        "dsn_file": {
          "minLength": 1,
          "title": "Dsn File",
          "type": "string"
        },
        "pool_max_size": {
          "minimum": 1,
          "title": "Pool Max Size",
          "type": "integer"
        },
        "pool_min_size": {
          "minimum": 1,
          "title": "Pool Min Size",
          "type": "integer"
        },
        "query": {
          "title": "Query",
          "type": "string"
        },
        "statement_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Statement Timeout Seconds",
          "type": "number"
        },
        "type": {
          "const": "store_sql",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "dsn_file",
        "query",
        "default_upstream",
        "pool_min_size",
        "pool_max_size",
        "connect_timeout_seconds",
        "statement_timeout_seconds"
      ],
      "title": "StoreSqlResolverConfig",
      "type": "object"
    },
    "TokenBucketConfig": {
      "additionalProperties": false,
      "description": "One token bucket: ``burst`` is the capacity (and the starting level), ``per_minute`` the refill.",
      "properties": {
        "burst": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Burst",
          "type": "integer"
        },
        "per_minute": {
          "minimum": 0.001,
          "title": "Per Minute",
          "type": "number"
        }
      },
      "required": [
        "burst",
        "per_minute"
      ],
      "title": "TokenBucketConfig",
      "type": "object"
    },
    "ToolAccessConfig": {
      "additionalProperties": false,
      "description": "Which tools a caller may see and call: exact names, ``*`` as the only wildcard.",
      "properties": {
        "allow": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Allow"
        },
        "deny": {
          "items": {
            "type": "string"
          },
          "title": "Deny",
          "type": "array"
        }
      },
      "required": [
        "allow",
        "deny"
      ],
      "title": "ToolAccessConfig",
      "type": "object"
    },
    "ToolRuleConfig": {
      "additionalProperties": false,
      "properties": {
        "allow": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Allow"
        },
        "deny": {
          "items": {
            "type": "string"
          },
          "title": "Deny",
          "type": "array"
        },
        "match": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrganizationMatchConfig"
            },
            {
              "$ref": "#/$defs/LabelMatchConfig"
            }
          ],
          "title": "Match"
        }
      },
      "required": [
        "allow",
        "deny",
        "match"
      ],
      "title": "ToolRuleConfig",
      "type": "object"
    },
    "ToolsPolicyConfig": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/$defs/ToolAccessConfig"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/ToolRuleConfig"
          },
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "default",
        "rules"
      ],
      "title": "ToolsPolicyConfig",
      "type": "object"
    },
    "UpstreamConfig": {
      "additionalProperties": false,
      "properties": {
        "connect_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Connect Timeout Seconds",
          "type": "number"
        },
        "max_connections": {
          "exclusiveMinimum": 0,
          "title": "Max Connections",
          "type": "integer"
        },
        "max_detached_reads": {
          "exclusiveMinimum": 0,
          "title": "Max Detached Reads",
          "type": "integer"
        },
        "pool_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Pool Timeout Seconds",
          "type": "number"
        },
        "read_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Read Timeout Seconds",
          "type": "number"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "write_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Write Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "url",
        "connect_timeout_seconds",
        "read_timeout_seconds",
        "write_timeout_seconds",
        "pool_timeout_seconds",
        "max_connections",
        "max_detached_reads"
      ],
      "title": "UpstreamConfig",
      "type": "object"
    },
    "WebhookResolverConfig": {
      "additionalProperties": false,
      "properties": {
        "allow_insecure_http": {
          "title": "Allow Insecure Http",
          "type": "boolean"
        },
        "auth": {
          "discriminator": {
            "mapping": {
              "hmac": "#/$defs/HmacAuthConfig",
              "mtls": "#/$defs/MtlsAuthConfig"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/HmacAuthConfig"
            },
            {
              "$ref": "#/$defs/MtlsAuthConfig"
            }
          ],
          "title": "Auth"
        },
        "backoff_base_seconds": {
          "exclusiveMinimum": 0,
          "title": "Backoff Base Seconds",
          "type": "number"
        },
        "backoff_max_seconds": {
          "exclusiveMinimum": 0,
          "title": "Backoff Max Seconds",
          "type": "number"
        },
        "ca_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ca File"
        },
        "default_upstream": {
          "minLength": 1,
          "title": "Default Upstream",
          "type": "string"
        },
        "max_attempts": {
          "maximum": 10,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_ttl_seconds": {
          "exclusiveMinimum": 0,
          "title": "Max Ttl Seconds",
          "type": "number"
        },
        "timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "total_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Total Timeout Seconds",
          "type": "number"
        },
        "type": {
          "const": "webhook",
          "title": "Type",
