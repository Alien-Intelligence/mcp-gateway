{
  "version": 1,
  "public_url": "https://mcp.example.com/mcp",
  "listen": {
    "host": "0.0.0.0",
    "port": 8000
  },
  "auth": {
    "issuer": "https://idp.example.com/realms/example-publisher",
    "jwks_uri": "https://idp.example.com/realms/example-publisher/protocol/openid-connect/certs",
    "audiences": [
      "https://mcp.example.com/mcp"
    ],
    "algorithms": [
      "RS256"
    ],
    "required_scopes": [],
    "scopes_advertised": [
      "mcp-gateway",
      "offline_access"
    ],
    "clock_skew_seconds": 5,
    "jwks_cache_ttl_seconds": 300,
    "jwks_max_stale_seconds": 3600,
    "jwks_fetch_timeout_seconds": 5,
    "identity": {
      "subject": "sub",
      "email": "email",
      "email_verified": "email_verified",
      "organization": "org",
      "groups": "groups"
    },
    "userinfo": null
  },
  "resolver": {
    "type": "webhook",
    "url": "https://keys.example.com/resolve",
    "auth": {
      "type": "hmac",
      "secret_file": "/run/gateway/secrets/webhook-hmac"
    },
    "ca_file": null,
    "default_upstream": "main",
    "allow_insecure_http": false,
    "timeout_seconds": 3,
    "max_attempts": 3,
    "total_timeout_seconds": 8,
    "backoff_base_seconds": 0.2,
    "backoff_max_seconds": 2,
    "max_ttl_seconds": 600
  },
  "resolver_cache": {
    "positive_ttl_seconds": 300,
    "negative_ttl_seconds": 15,
    "max_entries": null
  },
  "upstreams": {
    "main": {
      "url": "https://alien-mcp.example.com/mcp",
      "connect_timeout_seconds": 10,
      "read_timeout_seconds": 130,
      "write_timeout_seconds": 30,
      "pool_timeout_seconds": 10,
      "max_connections": 200,
      "max_detached_reads": 50
    }
  },
  "limits": {
    "max_request_body_bytes": 1048576,
    "request_body_timeout_seconds": 30,
    "max_sse_event_bytes": 1048576,
    "max_filtered_response_bytes": 4194304
  },
  "audit": {
    "enabled": true
  },
  "observability": {
    "otlp": {
      "endpoint": "https://otel.example.com:4318",
      "protocol": "http/protobuf",
      "headers_file": "/run/gateway/secrets/otlp-headers",
      "allow_insecure_http": false,
      "timeout_seconds": 10,
      "export_interval_seconds": 15,
      "service_name": "mcp-gateway",
      "resource_attributes": {
        "deployment.environment": "production"
      }
    }
  },
  "sessions": {
    "max_entries": null,
    "max_entries_per_subject": 50,
    "idle_ttl_seconds": 600
  },
  "state": {
    "type": "redis",
    "url_file": "/run/gateway/secrets/state-redis-url",
    "key_prefix": "mcp-gateway:state:",
    "connect_timeout_seconds": 2,
    "operation_timeout_seconds": 2,
    "max_connections": 32,
    "encryption_key_file": "/run/gateway/secrets/state-encryption-key"
  },
  "policies": {
    "allowed_origins": [
      "https://claude.ai"
    ],
    "tools": null,
    "rate_limits": {
      "per_subject": {
        "burst": 30,
        "per_minute": 60
      },
      "per_organization": {
        "burst": 200,
        "per_minute": 600
      }
    }
  }
}
