# Tools image of the dev/stub stack: the seed step, the stub state writer and the end-to-end
# harness (pytest with the test dependencies). It is a test fixture, never a release artifact.
FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.8.13 /uv /bin/uv

ENV UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# Dependencies first so this layer is cached until the lockfile changes.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked --extra dev --no-install-project

COPY src ./src
COPY scripts ./scripts
COPY tests ./tests

# Owned by the runtime user: a fresh named volume mounted here inherits this ownership.
RUN mkdir -p /run/gateway/state /run/gateway/conn /out \
    && chown -R 1000:1000 /run/gateway /out /app

USER 1000:1000
