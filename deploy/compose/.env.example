# Copy to .env (never committed) and adjust. Compose reads it for the variables of compose.yaml.

# The image to run, required (no default). The pull location of the release image is announced in
# the project README. Until then, build it from the Dockerfile (deploy/compose/README.md gives the
# command) and set this to what you built, e.g. mcp-gateway:local, or to your registry's copy,
# better by digest (name@sha256:...).
MCP_GATEWAY_IMAGE=

# The gateway configuration (docs/configuration.md), started from config.static.example.json or
# config.store-redis.example.json. It holds no secret; keep it out of version control anyway, it
# describes your deployment.
MCP_GATEWAY_CONFIG_FILE=./config.json

# Directory of the secret files, created by init-secrets.sh: redis.conf (the Redis password) and
# gateway/ (Redis URL, state encryption key, static mapping and API key files), which is mounted
# read-only into the gateway at /run/mcp-gateway/secrets.
MCP_GATEWAY_SECRETS_DIR=./secrets

# Where the gateway's port is published on the host. Keep it on loopback and put the TLS reverse
# proxy in front (README.md).
MCP_GATEWAY_BIND=127.0.0.1:8000
