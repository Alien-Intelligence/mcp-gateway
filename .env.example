# Compose files of the dev target (the gateways forward to a real MCP server).
COMPOSE_FILE=compose.yaml:compose.dev.yaml
# Keycloak bootstrap admin (dev stack only).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=<generate-a-random-password>
# Shared password of the test users in both identity providers.
E2E_USER_PASSWORD=<generate-a-random-password>
# Hydra system secret (at least 32 characters).
HYDRA_SYSTEM_SECRET=<generate-32-plus-random-characters>
# PostgreSQL and Redis passwords of the credential stores (alphanumeric: they go into URLs).
POSTGRES_PASSWORD=<generate-a-random-alphanumeric-password>
REDIS_PASSWORD=<generate-a-random-alphanumeric-password>
# Shared secret the gateway signs webhook calls with and the dev webhook service verifies.
WEBHOOK_HMAC_SECRET=<generate-a-random-secret>
# MCP servers the gateways forward to: the "stateful" and the "stateless" upstream. The real dev
# MCP servers are stateless, so both normally name the same URL.
UPSTREAM_STATEFUL_URL=https://<your-mcp-server>/mcp
UPSTREAM_STATELESS_URL=https://<your-mcp-server>/mcp
# policies.rate_limits of the two-replica pair (gateway-ha-a, gateway-ha-b behind gateway-lb), as JSON,
# or null for no limit. The stub target's script uses a small burst so tests can exhaust it:
# '{"per_subject": {"burst": 8, "per_minute": 1}, "per_organization": {"burst": 12, "per_minute": 1}}'
HA_RATE_LIMITS=null
# Host directory holding the gateway state (written by scripts/dev_fixture.py), mounted read-only.
MCP_GATEWAY_STATE_DIR=<absolute-path-to-a-local-state-dir>

# CI real-dev target only (scripts/ci_e2e_dev.sh, compose.ci-dev.yaml). In CI these are protected
# variables; to run the script by hand, point the *_FILE ones at files and set the others.
# E2E_DEV_SPONSOR_KEY_FILE=<path-to-the-sponsor-service-account-key-file>
# E2E_DEV_ALICE_KEY_FILE=<path-to-alice-key-file>
# E2E_DEV_BOB_KEY_FILE=<path-to-bob-key-file>
# E2E_DEV_CAROL_KEY_FILE=<path-to-carol-key-file>
# E2E_DEV_FIXTURE_FILE=<path-to-fixture.json>
# E2E_DEV_UPSTREAM_URL=https://<your-mcp-server>/mcp
# E2E_DEV_API_BASE=https://<your-alien-api>
# E2E_DEV_EXISTING_JOB_ID=<a-job-id-the-personas-do-not-own>
