{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mcp-gateway chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "description": "The MCP_GATEWAY_CONFIG document (docs/configuration.md), validated against docs/config.schema.v1.json when set. Generated by scripts/gen_config_schema.py.",
      "if": {
        "minProperties": 1
      },
      "then": {
        "additionalProperties": false,
        "properties": {
          "audit": {
            "$ref": "#/$defs/AuditConfig"
          },
          "auth": {
            "$ref": "#/$defs/AuthConfig"
          },
          "limits": {
            "$ref": "#/$defs/LimitsConfig"
          },
          "listen": {
            "$ref": "#/$defs/ListenConfig"
          },
          "observability": {
            "$ref": "#/$defs/ObservabilityConfig"
          },
          "policies": {
            "$ref": "#/$defs/PoliciesConfig"
          },
          "public_url": {
            "title": "Public Url",
            "type": "string"
          },
          "resolver": {
            "discriminator": {
              "mapping": {
                "chain": "#/$defs/ChainResolverConfig",
                "static": "#/$defs/StaticResolverConfig",
                "store_redis": "#/$defs/StoreRedisResolverConfig",
                "store_sql": "#/$defs/StoreSqlResolverConfig",
                "webhook": "#/$defs/WebhookResolverConfig"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/StaticResolverConfig"
              },
              {
                "$ref": "#/$defs/WebhookResolverConfig"
              },
              {
                "$ref": "#/$defs/StoreSqlResolverConfig"
              },
              {
                "$ref": "#/$defs/StoreRedisResolverConfig"
              },
              {
                "$ref": "#/$defs/ChainResolverConfig"
              }
            ],
            "title": "Resolver"
          },
          "resolver_cache": {
            "anyOf": [
              {
                "$ref": "#/$defs/ResolverCacheConfig"
              },
              {
                "type": "null"
              }
            ]
          },
          "sessions": {
            "$ref": "#/$defs/SessionsConfig"
          },
          "state": {
            "discriminator": {
              "mapping": {
                "memory": "#/$defs/MemoryStateConfig",
                "redis": "#/$defs/RedisStateConfig"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/MemoryStateConfig"
              },
              {
                "$ref": "#/$defs/RedisStateConfig"
              }
            ],
            "title": "State"
          },
          "upstreams": {
            "additionalProperties": {
              "$ref": "#/$defs/UpstreamConfig"
            },
            "minProperties": 1,
            "title": "Upstreams",
            "type": "object"
          },
          "version": {
            "const": 1,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "public_url",
          "listen",
          "auth",
          "resolver",
          "resolver_cache",
          "upstreams",
          "limits",
          "audit",
          "observability",
          "sessions",
          "state",
          "policies"
        ],
        "type": "object"
      }
    },
    "existingSecret": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "sharedState": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "key",
        "sharedState"
      ]
    },
    "secretMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "secretName": {
            "type": "string",
            "minLength": 1
          },
          "mountPath": {
            "type": "string",
            "pattern": "^/"
          },
          "defaultMode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 511
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "mode": {
                  "type": "integer"
                }
              },
              "additionalProperties": false,
              "required": [
                "key",
                "path"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "secretName",
          "mountPath"
        ]
      }
    },
    "secretEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "secretName": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "secretName",
          "key"
        ]
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ]
      }
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "publicPath": {
      "type": "string",
      "pattern": "^/.+"
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        },
        "nodePort": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 30000,
          "maximum": 32767
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "port",
        "annotations"
      ]
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "create",
        "name",
        "annotations",
        "automountServiceAccountToken"
      ]
    },
    "terminationGracePeriodSeconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "preStopSleepSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "startupProbe": {
      "type": "object",
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "readinessProbe": {
      "type": "object",
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "livenessProbe": {
      "type": "object",
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "strategy": {
      "type": "object"
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas"
      ]
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        },
        "minAvailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": []
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "host"
            ]
          }
        },
        "tls": {
          "type": "array"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "parentRefs": {
          "type": "array"
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeouts": {
          "type": "object",
          "properties": {
            "request": {
              "type": "string"
            },
            "backendRequest": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    }
  },
  "$defs": {
    "AuditConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "AuditConfig",
      "type": "object"
    },
    "AuthConfig": {
      "additionalProperties": false,
      "properties": {
        "algorithms": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Algorithms",
          "type": "array"
        },
        "audiences": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Audiences",
          "type": "array"
        },
        "clock_skew_seconds": {
          "minimum": 0,
          "title": "Clock Skew Seconds",
          "type": "number"
        },
        "identity": {
          "$ref": "#/$defs/IdentityPathsConfig"
        },
        "issuer": {
          "title": "Issuer",
          "type": "string"
        },
        "jwks_cache_ttl_seconds": {
          "exclusiveMinimum": 0,
          "title": "Jwks Cache Ttl Seconds",
          "type": "number"
        },
        "jwks_fetch_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Jwks Fetch Timeout Seconds",
          "type": "number"
        },
        "jwks_max_stale_seconds": {
          "minimum": 0,
          "title": "Jwks Max Stale Seconds",
          "type": "number"
        },
        "jwks_uri": {
          "title": "Jwks Uri",
          "type": "string"
        },
        "required_scopes": {
          "items": {
            "type": "string"
          },
          "title": "Required Scopes",
          "type": "array"
        },
        "scopes_advertised": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Scopes Advertised",
          "type": "array"
        },
        "userinfo": {
          "anyOf": [
            {
              "$ref": "#/$defs/UserinfoConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "issuer",
        "jwks_uri",
        "audiences",
        "algorithms",
        "required_scopes",
        "scopes_advertised",
        "clock_skew_seconds",
        "jwks_cache_ttl_seconds",
        "jwks_max_stale_seconds",
        "jwks_fetch_timeout_seconds",
        "identity",
        "userinfo"
      ],
      "title": "AuthConfig",
      "type": "object"
    },
    "ChainResolverConfig": {
      "additionalProperties": false,
      "properties": {
        "resolvers": {
          "items": {
            "discriminator": {
              "mapping": {
                "static": "#/$defs/StaticResolverConfig",
                "store_redis": "#/$defs/StoreRedisResolverConfig",
                "store_sql": "#/$defs/StoreSqlResolverConfig",
                "webhook": "#/$defs/WebhookResolverConfig"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/StaticResolverConfig"
              },
              {
                "$ref": "#/$defs/WebhookResolverConfig"
              },
              {
                "$ref": "#/$defs/StoreSqlResolverConfig"
              },
              {
                "$ref": "#/$defs/StoreRedisResolverConfig"
              }
            ]
          },
          "minItems": 2,
          "title": "Resolvers",
          "type": "array"
        },
        "type": {
          "const": "chain",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "resolvers"
      ],
      "title": "ChainResolverConfig",
      "type": "object"
    },
    "HmacAuthConfig": {
      "additionalProperties": false,
      "properties": {
        "secret_file": {
          "minLength": 1,
          "title": "Secret File",
          "type": "string"
        },
        "type": {
          "const": "hmac",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "secret_file"
      ],
      "title": "HmacAuthConfig",
      "type": "object"
    },
    "IdentityPathsConfig": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Email"
        },
        "email_verified": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Email Verified"
        },
        "groups": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Groups"
        },
        "organization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Organization"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "email",
        "email_verified",
        "organization",
        "groups"
      ],
      "title": "IdentityPathsConfig",
      "type": "object"
    },
    "LabelMatchConfig": {
      "additionalProperties": false,
      "description": "Matches one of the labels the credential resolver returned.",
      "properties": {
        "label": {
          "$ref": "#/$defs/LabelSelectorConfig"
        }
      },
      "required": [
        "label"
      ],
      "title": "LabelMatchConfig",
      "type": "object"
    },
    "LabelSelectorConfig": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "LabelSelectorConfig",
      "type": "object"
    },
    "LimitsConfig": {
      "additionalProperties": false,
      "properties": {
        "max_filtered_response_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Filtered Response Bytes",
          "type": "integer"
        },
        "max_request_body_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Request Body Bytes",
          "type": "integer"
        },
        "max_sse_event_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Sse Event Bytes",
          "type": "integer"
        },
        "request_body_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Request Body Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "max_request_body_bytes",
        "request_body_timeout_seconds",
        "max_sse_event_bytes",
        "max_filtered_response_bytes"
      ],
      "title": "LimitsConfig",
      "type": "object"
    },
    "ListenConfig": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        }
      },
      "required": [
        "host",
        "port"
      ],
      "title": "ListenConfig",
      "type": "object"
    },
    "MemoryStateConfig": {
      "additionalProperties": false,
      "description": "Per-process state: correct for exactly one replica.",
      "properties": {
        "type": {
          "const": "memory",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "MemoryStateConfig",
      "type": "object"
    },
    "MtlsAuthConfig": {
      "additionalProperties": false,
      "properties": {
        "client_cert_file": {
          "minLength": 1,
          "title": "Client Cert File",
          "type": "string"
        },
        "client_key_file": {
          "minLength": 1,
          "title": "Client Key File",
          "type": "string"
        },
        "type": {
          "const": "mtls",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "client_cert_file",
        "client_key_file"
      ],
      "title": "MtlsAuthConfig",
      "type": "object"
    },
    "ObservabilityConfig": {
      "additionalProperties": false,
      "properties": {
        "otlp": {
          "anyOf": [
            {
              "$ref": "#/$defs/OtlpConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "otlp"
      ],
      "title": "ObservabilityConfig",
      "type": "object"
    },
    "OrganizationMatchConfig": {
      "additionalProperties": false,
      "description": "Matches ``Identity.organization`` (the token's organization claim).",
      "properties": {
        "organization": {
          "minLength": 1,
          "title": "Organization",
          "type": "string"
        }
      },
      "required": [
        "organization"
      ],
      "title": "OrganizationMatchConfig",
      "type": "object"
    },
    "OtlpConfig": {
      "additionalProperties": false,
      "description": "OTLP export of traces and metrics. Only the endpoint's address is configured here.",
      "properties": {
        "allow_insecure_http": {
          "title": "Allow Insecure Http",
          "type": "boolean"
        },
        "endpoint": {
          "title": "Endpoint",
          "type": "string"
        },
        "export_interval_seconds": {
          "exclusiveMinimum": 0,
          "title": "Export Interval Seconds",
          "type": "number"
        },
        "headers_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Headers File"
        },
        "protocol": {
          "enum": [
            "grpc",
            "http/protobuf"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "resource_attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Resource Attributes",
          "type": "object"
        },
        "service_name": {
          "minLength": 1,
          "title": "Service Name",
          "type": "string"
        },
        "timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "endpoint",
        "protocol",
        "headers_file",
        "allow_insecure_http",
        "timeout_seconds",
        "export_interval_seconds",
        "service_name",
        "resource_attributes"
      ],
      "title": "OtlpConfig",
