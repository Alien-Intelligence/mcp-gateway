{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mcp-gateway chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "description": "The MCP_GATEWAY_CONFIG document (docs/configuration.md). When set it must declare \"version\": 1.",
      "if": {
        "minProperties": 1
      },
      "then": {
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "const": 1,
            "description": "The configuration schema version; 1 is the only one supported."
          }
        }
      }
    },
    "existingSecret": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "sharedState": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "key",
        "sharedState"
      ]
    },
    "secretMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "secretName": {
            "type": "string",
            "minLength": 1
          },
          "mountPath": {
            "type": "string",
            "pattern": "^/"
          },
          "defaultMode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 511
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "mode": {
                  "type": "integer"
                }
              },
              "additionalProperties": false,
              "required": [
                "key",
                "path"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "secretName",
          "mountPath"
        ]
      }
    },
    "secretEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "secretName": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "secretName",
          "key"
        ]
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ]
      }
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "publicPath": {
      "type": "string",
      "pattern": "^/.+"
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        },
        "nodePort": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 30000,
          "maximum": 32767
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "port",
        "annotations"
      ]
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "create",
        "name",
        "annotations",
        "automountServiceAccountToken"
      ]
    },
    "terminationGracePeriodSeconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "preStopSleepSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "startupProbe": {
      "type": "object",
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "readinessProbe": {
      "type": "object",
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "livenessProbe": {
      "type": "object",
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "strategy": {
      "type": "object"
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas"
      ]
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        },
        "minAvailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": []
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "host"
            ]
          }
        },
        "tls": {
          "type": "array"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "parentRefs": {
          "type": "array"
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeouts": {
          "type": "object",
          "properties": {
            "request": {
              "type": "string"
            },
            "backendRequest": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    }
  }
}
